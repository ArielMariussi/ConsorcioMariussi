@page "/cadastro"
@layout AuthLayout
@inject ApiClient Api
@inject Sessao Sessao
@inject NavigationManager Nav

<PageTitle>Criar conta · ConsórcioMariussi</PageTitle>

<main class="auth-card">
    <a href="/" class="brand auth-card__brand">
        <span class="brand__mark">CM</span>
        <span class="brand__name">Consórcio<strong>Mariussi</strong></span>
    </a>

    <h1 class="auth-card__title">Criar conta</h1>

    @if (mensagem is not null)
    {
        <p class="alert alert--error auth-card__alert">@mensagem</p>
    }

    <EditForm EditContext="contexto" OnValidSubmit="EnviarAsync" class="auth__form" novalidate>
        <DataAnnotationsValidator />

        <label class="field">
            <span>E-mail</span>
            <InputText type="email" @bind-Value="form.Email" autocomplete="email" class="input" placeholder="voce@email.com" />
            <ValidationMessage For="() => form.Email" />
        </label>

        <label class="field">
            <span>Senha</span>
            @* A referência pede no mínimo 8 caracteres, mas vale o contrato: de 3 a 30. *@
            <InputText type="password" @bind-Value="form.Password" autocomplete="new-password" class="input" placeholder="••••••••" />
            <ValidationMessage For="() => form.Password" />
        </label>

        <button type="submit" class="btn btn--primary btn--block" disabled="@enviando">Criar conta</button>
    </EditForm>

    <p class="auth__switch">Já tem conta? <a href="/login" class="link">Entrar</a></p>
</main>

@code {
    private readonly CadastroForm form = new();
    private EditContext contexto = default!;
    private ValidationMessageStore erros = default!;
    private string? mensagem;
    private bool enviando;

    protected override async Task OnInitializedAsync()
    {
        contexto = new EditContext(form);
        erros = new ValidationMessageStore(contexto);
        contexto.OnFieldChanged += (_, e) => erros.Clear(e.FieldIdentifier);

        if (await Sessao.EstaAutenticadaAsync())
            Nav.NavigateTo("/");
    }

    private async Task EnviarAsync()
    {
        enviando = true;
        mensagem = null;
        erros.Clear();

        var resultado = await Api.RegistrarAsync(form);
        enviando = false;

        if (resultado.Sucesso)
        {
            Nav.NavigateTo("/login?cadastro=1");
            return;
        }

        mensagem = resultado.Mensagem;
        resultado.AplicarErros(contexto, erros);
    }
}
